# Copie para .env e preencha. O .env nunca vai para o Git.

# Chave gratuita do Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fixe uma versão antes de rodar a avaliação oficial (ex.: gemini-2.5-flash)
GEMINI_MODEL=gemini-flash-latest

# Gere com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# URL pública do formulário. Local: http://localhost:5679/
# No piloto, troque pela URL do túnel (docker compose --profile tunnel up) e reinicie o n8n.
WEBHOOK_URL=http://localhost:5679/

GENERIC_TIMEZONE=America/Sao_Paulo

# Porta local do editor e do formulário (a 5678 costuma estar ocupada por outro n8n)
N8N_PORTA=5679
